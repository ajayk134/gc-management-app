{
  "name": "gc-management-app",
  "version": "1.0.0",
  "description": "Gift Card Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "vite build",
    "init-admin": "node scripts/init-admin.js",
    "test:seed": "node scripts/seed-test-db.js",
    "test:api": "node scripts/seed-test-db.js && (test -f tests/api-test.js && node tests/api-test.js || echo 'Note: tests/api-test.js is local-only (tests/ is gitignored) - skipping.')",
    "test:downtime:unit": "node tests/downtime-unit-test.js",
    "test:payments:unit": "node tests/payment-summary-unit-test.js",
    "test:payments:api": "node tests/payment-summary-api-test.js",
    "test:payments:e2e": "node tests/payment-summary-e2e.js",
    "test:downtime:api": "node tests/downtime-api-test.js",
    "test:downtime:e2e": "node tests/downtime-e2e.js",
    "test": "npm run test:api",
    "test:downtime:scheduler": "node tests/downtime-scheduler-test.js",
    "test:downtime": "npm run test:downtime:unit && npm run test:downtime:scheduler && npm run test:downtime:restart",
    "test:downtime:restart": "node tests/downtime-restart-test.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "lucide-react": "^0.303.0",
    "mongoose": "^8.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.21.1",
    "vite": "^5.0.10",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
